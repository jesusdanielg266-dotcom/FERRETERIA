  if(t.dataset.stock){var ps=products();ps.forEach(function(p){if(p.id===t.dataset.stock)p.stock=Math.max(0,parseInt(t.value,10)||0)});saveProducts(ps);toast('Stock actualizado');return}
  if(t.dataset.status){
    var os=orders();os.forEach(function(o){
      if(o.id!==t.dataset.status)return;
      var was=o.status,now=t.value,ps2=products();
      if(was!=='cancelado'&&now==='cancelado')o.items.forEach(function(i){ps2.forEach(function(p){if(p.id===i.id)p.stock+=i.qty})});
      if(was==='cancelado'&&now!=='cancelado')o.items.forEach(function(i){ps2.forEach(function(p){if(p.id===i.id)p.stock=Math.max(0,p.stock-i.qty)})});
      o.status=now;saveProducts(ps2);
    });
    LS.set('fm_orders',os);toast('Estado actualizado');render(true);return;
  }
  if(t.id==='f-img'&&t.files&&t.files[0]){
    readImg(t.files[0]).then(function(d){S.formImg=d;$('#prev').innerHTML='<div class="tile c-herr"><img src="'+d+'" alt=""></div>'}).catch(function(){$('#pf-err').textContent='No se pudo leer la imagen. Prueba con otra.'});
  }
});
function readImg(file){return new Promise(function(res,rej){var fr=new FileReader();fr.onload=function(){var im=new Image();im.onload=function(){var m=600,r=Math.min(1,m/Math.max(im.width,im.height)),c=document.createElement('canvas');c.width=Math.round(im.width*r);c.height=Math.round(im.height*r);c.getContext('2d').drawImage(im,0,0,c.width,c.height);res(c.toDataURL('image/jpeg',.8))};im.onerror=rej;im.src=fr.result};fr.onerror=rej;fr.readAsDataURL(file)})}

