  },
  checkout:function(){
    var err=$('#c-err'),f={name:$('#c-name').value.trim(),phone:$('#c-phone').value.trim(),email:$('#c-email').value.trim(),address:$('#c-addr').value.trim(),city:$('#c-city').value.trim()};
    if(f.name.length<2||f.address.length<5||f.city.length<2){err.textContent='Completa nombre, dirección y ciudad.';return}
    if(f.phone.replace(/\D/g,'').length<7){err.textContent='Escribe un celular válido para coordinar la entrega.';return}
    var ls=cartLines(),ps=products();
    for(var i=0;i<ls.length;i++){if(ls[i].p.stock<ls[i].q){err.textContent='Ya no quedan suficientes unidades de '+ls[i].p.name+'. Ajusta tu carrito.';return}}
    var sub=ls.reduce(function(a,l){return a+l.p.price*l.q},0),sh=shipping(sub),os=orders();
    var o={id:'FH-'+String(os.length+1).padStart(4,'0'),date:new Date().toISOString(),userId:session().userId||null,gid:gid(),customer:f,pay:$('#c-pay').value,items:ls.map(function(l){return{id:l.p.id,name:l.p.name,price:l.p.price,qty:l.q}}),ship:sh,total:sub+sh,status:'pendiente'};
    ls.forEach(function(l){ps.forEach(function(p){if(p.id===l.p.id)p.stock-=l.q})});
    saveProducts(ps);os.push(o);LS.set('fm_orders',os);LS.set('fm_guestinfo',f);saveCart({});S.done=o;render(false);
  },
  pass:async function(){
    var np=$('#np').value;if(np.length<6){$('#p-err').textContent='Usa al menos 6 caracteres.';return}
    var us=users(),h=await hash(np);us.forEach(function(u){if(u.id===session().userId)u.pass=h});LS.set('fm_users',us);$('#np').value='';toast('Contraseña actualizada');
  },
  product:function(){
    var err=$('#pf-err'),name=$('#pf-name').value.trim(),price=parseInt($('#pf-price').value,10),old=parseInt($('#pf-old').value,10)||0,stock=parseInt($('#pf-stock').value,10);
    if(name.length<2){err.textContent='Escribe el nombre del producto.';return}
    if(!(price>0)){err.textContent='El precio debe ser mayor que cero.';return}
    if(old&&old<=price){err.textContent='El precio anterior debe ser mayor que el precio actual para mostrar el descuento.';return}
    if(!(stock>=0)){err.textContent='Indica las unidades en stock.';return}
    var ps=products(),data={name:name,cat:$('#pf-cat').value,brand:$('#pf-brand').value.trim()||'Genérica',price:price,old:old,stock:stock,desc:$('#pf-desc').value.trim(),icon:$('#pf-icon').value,img:S.formImg||''};
    if(S.editing==='new'){var n=ps.reduce(function(a,p){return Math.max(a,parseInt(p.id.replace(/\D/g,''),10)||0)},0)+1;data.id='p'+n;ps.push(data)}
    else ps.forEach(function(p,i){if(p.id===S.editing){data.id=p.id;ps[i]=data}});
    saveProducts(ps);S.editing=null;toast('Producto guardado');render(true);
  }
};
document.addEventListener('submit',function(e){var f=e.target.closest('form[data-form]');if(!f)return;e.preventDefault();FORMS[f.dataset.form](f)});

boot();
})();
</script>

