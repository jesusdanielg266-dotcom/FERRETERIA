function clientStats(){
  var os=orders(),list=users().filter(function(u){return u.role==='cliente'}).map(function(u){
    var mine=os.filter(function(o){return o.userId===u.id});
    return{key:u.id,name:u.name,email:u.email,phone:u.phone,created:u.created,n:mine.length,total:mine.filter(function(o){return o.status!=='cancelado'}).reduce(function(a,o){return a+o.total},0),guest:false};
  }),gm={};
  os.filter(function(o){return!o.userId}).forEach(function(o){
    var k='g:'+digits(o.customer.phone),c=gm[k]||(gm[k]={key:k,name:o.customer.name,email:o.customer.email,phone:o.customer.phone,created:o.date,n:0,total:0,guest:true});
