function addToCart(id,q){
  var p=prod(id);if(!p||p.stock<=0){toast('Producto agotado');return false}
  var c=cart(),n=(c[id]||0)+q;
  if(n>p.stock){n=p.stock;toast('Solo hay '+p.stock+' unidades')}else toast('Agregado al carrito');
  c[id]=n;saveCart(c);updateChrome(view());return true;
}
