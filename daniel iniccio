function render(keep){
  var h=(location.hash||'#inicio').slice(1),parts=h.split('-'),v=parts[0],id=parts.slice(1).join('-'),y=window.scrollY;
  if(((v==='carrito'||v==='pedido')&&!F.cart)||(v==='deseados'&&!F.wish)||(v==='compra'&&!F.hist)||((v==='cuenta'||v==='ingresar'||v==='ajustes')&&!F.auth)||(v==='admin'&&!F.admin)||(v==='ayuda'&&!F.help)||(v==='producto'&&!F.home))v='inicio';
  if(v==='ajustes'&&session().role==='guest')v='ingresar';
  if(v!=='pedido')S.done=null;
  if(v==='admin'&&session().role!=='admin'){location.hash='#ingresar';return}
  var html;
  switch(v){
    case'producto':html=viewProduct(id);break;
    case'deseados':html=viewWish();break;
    case'carrito':html=viewCart();break;
    case'pedido':html=viewCheckout();break;
    case'cuenta':html=viewAccount();break;
    case'ingresar':html=viewAuth();break;
    case'admin':html=viewAdmin();break;
    case'ayuda':html=viewHelp();break;
    case'compra':html=viewOrder(id);break;
    case'ajustes':html=viewSettings();break;
    default:v='inicio';html=viewHome();
  }
  $('#app').innerHTML=html;
  if(!F.help)$$('#app a[href="#ayuda"]').forEach(function(a){a.remove()});
  updateChrome(v);
  window.scrollTo(0,keep?y:0);
}
