<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>FerroHub</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600&family=Barlow+Condensed:wght@600;700;800&display=swap">
<style>
/* Layout: tienda móvil primero. Cabecera oscura fija con buscador, rejilla de 2 columnas como una tienda de moda rápida, barra inferior de pestañas. Paleta de taller: carbón, amarillo de seguridad, rojo de oferta. */
:root{
  --bg:#f4f3ef;--surface:#ffffff;--ink:#1c1e21;--muted:#666a70;--line:#e2e0da;
  --accent:#f4b400;--accent-ink:#1c1e21;--sale:#d33a2c;--ok:#2c8a57;--warn:#b86e00;
  --head:#1c1e21;--head-ink:#f4f3ef;--ico:#2b3036;
  --t-herr:#f1e6cf;--t-elec:#dfe6ee;--t-pint:#f3dcd5;--t-plom:#d8e9ec;--t-luz:#f5eec4;--t-torn:#e6e4de;--t-seg:#f4dcc4;--t-cons:#e3e0d3;
  --f-display:'Barlow Condensed','Arial Narrow',sans-serif;--f-body:'Barlow',system-ui,-apple-system,'Segoe UI',sans-serif;
}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){
  --bg:#141618;--surface:#1e2124;--ink:#ecebe6;--muted:#9a9ea5;--line:#2f3337;
  --sale:#ff6b5c;--ok:#4cc58a;--warn:#f0a63a;--head:#0e0f11;--head-ink:#ecebe6;--ico:#d4d7da;
  --t-herr:#3a3426;--t-elec:#2a323b;--t-pint:#3d2c27;--t-plom:#263a3e;--t-luz:#3b3820;--t-torn:#32312d;--t-seg:#3d3023;--t-cons:#34322a;color-scheme:dark}}
:root[data-theme="dark"]{
  --bg:#141618;--surface:#1e2124;--ink:#ecebe6;--muted:#9a9ea5;--line:#2f3337;
  --sale:#ff6b5c;--ok:#4cc58a;--warn:#f0a63a;--head:#0e0f11;--head-ink:#ecebe6;--ico:#d4d7da;
  --t-herr:#3a3426;--t-elec:#2a323b;--t-pint:#3d2c27;--t-plom:#263a3e;--t-luz:#3b3820;--t-torn:#32312d;--t-seg:#3d3023;--t-cons:#34322a;color-scheme:dark}
*{box-sizing:border-box}
body{background:var(--bg);color:var(--ink);font-family:var(--f-body);font-size:15px;line-height:1.4}
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);z-index:30;background:var(--head)}
a{color:inherit;text-decoration:none}
button,input,select,textarea{font:inherit;color:inherit}
button{cursor:pointer}
:focus-visible{outline:3px solid var(--accent);outline-offset:2px}
h1,h2,h3{font-family:var(--f-display);text-transform:uppercase;letter-spacing:.02em;margin:0;line-height:1.05}
.in{width:100%;max-width:1100px;margin-inline:auto;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px))}
main.in{padding-block:14px 110px;min-height:70vh}
.top{position:sticky;top:env(safe-area-inset-top,0px);z-index:20;background:var(--head);color:var(--head-ink)}
.bar{display:flex;align-items:center;gap:12px;padding-block:10px}
.logo{font-family:var(--f-display);font-weight:800;font-size:26px;letter-spacing:.03em;white-space:nowrap;display:flex;align-items:center;gap:2px}
.logo b{background:var(--accent);color:var(--accent-ink);padding:0 6px;border-radius:3px;font-weight:800}
.search{flex:1;min-width:0;display:flex;align-items:center;gap:8px;background:var(--surface);color:var(--ink);border-radius:999px;padding:0 14px;height:40px}
.search svg{flex:none;width:18px;height:18px;color:var(--muted)}
.search input{flex:1;min-width:0;border:0;background:transparent;outline:0;height:100%}
.hazard{height:7px;background:repeating-linear-gradient(135deg,var(--accent) 0 12px,#1c1e21 12px 24px)}
.tabs{position:fixed;left:0;right:0;bottom:0;z-index:20;background:var(--surface);border-top:1px solid var(--line);padding-bottom:env(safe-area-inset-bottom,0px)}
.tabs .in{display:flex;justify-content:space-around;gap:4px;padding-block:4px}
.tab{position:relative;flex:1;display:flex;flex-direction:column;align-items:center;gap:2px;padding:6px 2px;font-size:11px;font-weight:600;color:var(--muted);border-radius:8px}
.tab svg{width:24px;height:24px}
.tab.on{color:var(--ink)}
.tab.on svg{color:var(--ink)}
.tab.on::after{content:"";position:absolute;top:-5px;left:30%;right:30%;height:3px;background:var(--accent);border-radius:2px}
.cnt{position:absolute;top:1px;left:calc(50% + 6px);min-width:18px;height:18px;padding:0 5px;border-radius:9px;background:var(--sale);color:#fff;font-size:11px;line-height:18px;text-align:center;font-weight:700}
.cnt[hidden]{display:none}
.promo{background:var(--accent);color:var(--accent-ink);border-radius:6px;padding:10px 14px;display:flex;gap:10px;align-items:center;justify-content:space-between;flex-wrap:wrap;font-weight:600;margin-bottom:14px}
.promo span{font-family:var(--f-display);font-size:19px;text-transform:uppercase;letter-spacing:.03em}
.promo small{font-size:13px;font-weight:500}
.rail{display:flex;gap:10px;overflow-x:auto;padding-bottom:8px;scrollbar-width:thin}
.chips{margin-bottom:12px}
.chip{flex:none;border:1px solid var(--line);background:var(--surface);border-radius:999px;padding:7px 14px;font-weight:500;font-size:14px}
.chip.on{background:var(--ink);color:var(--bg);border-color:var(--ink)}
.sec{display:flex;align-items:baseline;justify-content:space-between;gap:10px;margin:18px 0 8px}
.sec h2{font-size:24px}
.sec small{color:var(--muted)}
.rail .card{flex:none;width:150px}
.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
@media (min-width:560px){.grid{grid-template-columns:repeat(3,minmax(0,1fr))}.rail .card{width:170px}}
@media (min-width:860px){.grid{grid-template-columns:repeat(5,minmax(0,1fr))}}
.card{position:relative;background:var(--surface);border-radius:8px;overflow:hidden;border:1px solid var(--line);display:flex;flex-direction:column}
.pic{display:block;position:relative}
.tile{aspect-ratio:1/1;max-width:100%;display:grid;place-items:center;overflow:hidden}
.tile img{width:100%;height:100%;object-fit:cover}
.tile svg{width:56%;height:56%}
.ico .p{fill:var(--ico)}.ico .a{fill:var(--accent)}.ico .s{fill:var(--surface)}
.ico .l{fill:none;stroke:var(--ico);stroke-width:5;stroke-linecap:round}
.c-herr{background:var(--t-herr)}.c-elec{background:var(--t-elec)}.c-pint{background:var(--t-pint)}.c-plom{background:var(--t-plom)}
.c-luz{background:var(--t-luz)}.c-torn{background:var(--t-torn)}.c-seg{background:var(--t-seg)}.c-cons{background:var(--t-cons)}
.badge{position:absolute;left:8px;font-size:12px;font-weight:700;border-radius:4px;padding:2px 7px}
.badge.sale{top:8px;background:var(--sale);color:#fff}
.badge.low{bottom:8px;background:var(--surface);color:var(--warn)}
.badge.out{bottom:8px;background:var(--ink);color:var(--bg)}
.heart{position:absolute;top:6px;right:6px;width:34px;height:34px;border-radius:50%;border:0;background:color-mix(in srgb,var(--surface) 88%,transparent);display:grid;place-items:center;color:var(--ink)}
.heart svg{width:19px;height:19px;fill:none;stroke:currentColor;stroke-width:2}
.heart.on{color:var(--sale)}
.heart.on svg{fill:currentColor}
.info{padding:9px 10px 44px}
.info.nocart{padding-bottom:12px}
.nm{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;font-size:14px;min-height:2.8em}
.pr{display:flex;align-items:baseline;gap:6px;margin-top:4px;flex-wrap:wrap}
.now{font-family:var(--f-display);font-weight:700;font-size:21px;font-variant-numeric:tabular-nums}
.now.hot{color:var(--sale)}
.pr s{color:var(--muted);font-size:13px}
.add{position:absolute;right:8px;bottom:8px;width:34px;height:34px;border-radius:50%;border:0;background:var(--accent);color:var(--accent-ink);display:grid;place-items:center}
.add svg{width:20px;height:20px}
.add:disabled{background:var(--line);color:var(--muted);cursor:not-allowed}
.toolbar{display:flex;align-items:center;justify-content:space-between;gap:10px;margin:6px 0 10px;color:var(--muted);font-size:14px}
select,input[type=text],input[type=email],input[type=password],input[type=number],input[type=tel],textarea{background:var(--surface);border:1px solid var(--line);border-radius:6px;padding:9px 10px;width:100%;min-width:0}
select{width:auto}
textarea{resize:vertical;min-height:80px}
label.fl{display:flex;flex-direction:column;gap:4px;font-size:13px;font-weight:600;color:var(--muted)}
label.fl input,label.fl select,label.fl textarea{color:var(--ink);font-weight:400;font-size:15px;width:100%}
.form{display:grid;gap:12px}
.row2{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
@media (max-width:420px){.row2{grid-template-columns:1fr}}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;border:0;border-radius:6px;padding:12px 18px;font-weight:700;background:var(--accent);color:var(--accent-ink);font-family:var(--f-display);text-transform:uppercase;letter-spacing:.04em;font-size:17px}
.btn.dark{background:var(--ink);color:var(--bg)}
.btn.ghost{background:transparent;color:var(--ink);border:1.5px solid var(--ink)}
.btn.sm{padding:7px 12px;font-size:14px}
.btn.danger{background:var(--sale);color:#fff}
.btn.block{width:100%}
.btn:disabled{opacity:.5;cursor:not-allowed}
.panel{background:var(--surface);border:1px solid var(--line);border-radius:8px;padding:14px}
.stack{display:grid;gap:12px}
.muted{color:var(--muted)}
.err{color:var(--sale);font-size:14px;min-height:1.2em;margin:0}
.ok{color:var(--ok)}
.back{display:inline-flex;align-items:center;gap:6px;background:none;border:0;padding:4px 0;font-weight:600;color:var(--muted);margin-bottom:8px}
.detail{display:grid;gap:16px}
@media (min-width:760px){.detail{grid-template-columns:minmax(0,1fr) minmax(0,1fr);align-items:start}}
.detail .tile{border-radius:8px}
.big{font-family:var(--f-display);font-weight:700;font-size:34px;font-variant-numeric:tabular-nums}
.stepper{display:inline-flex;align-items:center;border:1px solid var(--line);border-radius:6px;background:var(--surface)}
.stepper button{width:36px;height:36px;border:0;background:none;font-size:20px}
.stepper span{min-width:30px;text-align:center;font-weight:700;font-variant-numeric:tabular-nums}
.specs{display:grid;grid-template-columns:auto 1fr;gap:6px 16px;margin:0}
.specs dt{color:var(--muted)}.specs dd{margin:0}
.line{display:grid;grid-template-columns:72px minmax(0,1fr);gap:12px;padding:12px 0;border-bottom:1px solid var(--line)}
.line .tile{border-radius:6px}
.line .meta{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:8px;margin-top:6px}
.sum{display:grid;gap:6px}
.sum div{display:flex;justify-content:space-between;gap:10px;font-variant-numeric:tabular-nums}
.sum .tot{font-family:var(--f-display);font-size:26px;font-weight:700;border-top:2px solid var(--ink);padding-top:8px;margin-top:4px}
.tabsrow{display:flex;gap:6px;overflow-x:auto;margin-bottom:14px;border-bottom:2px solid var(--line)}
.tabsrow button{flex:none;border:0;background:none;padding:10px 14px;font-family:var(--f-display);text-transform:uppercase;font-size:18px;font-weight:700;letter-spacing:.03em;color:var(--muted);border-bottom:3px solid transparent;margin-bottom:-2px}
.tabsrow button.on{color:var(--ink);border-bottom-color:var(--accent)}
.kpis{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
@media (min-width:700px){.kpis{grid-template-columns:repeat(4,minmax(0,1fr))}}
.kpi{background:var(--surface);border:1px solid var(--line);border-radius:8px;padding:12px}
.kpi small{color:var(--muted);display:block}
.kpi b{font-family:var(--f-display);font-size:28px;font-variant-numeric:tabular-nums}
.arow{display:grid;grid-template-columns:52px minmax(0,1fr);gap:10px;align-items:center;padding:10px 0;border-bottom:1px solid var(--line)}
.arow .tile{border-radius:6px}
.arow .ctl{grid-column:1/-1;display:flex;flex-wrap:wrap;gap:8px;align-items:center}
.arow input[type=number]{width:84px}
.pill{display:inline-block;border-radius:999px;padding:2px 10px;font-size:12px;font-weight:700;background:var(--line);color:var(--ink)}
.pill.pendiente{background:#fde7a8;color:#5b4300}.pill.preparando{background:#cfe3f7;color:#14385e}
.pill.enviado{background:#e0d4f5;color:#3a2266}.pill.entregado{background:#cdeedb;color:#12502e}.pill.cancelado{background:#f7d0cb;color:#6b1a12}
.order{border:1px solid var(--line);background:var(--surface);border-radius:8px;padding:12px;display:grid;gap:8px}
.order header{display:flex;justify-content:space-between;gap:8px;flex-wrap:wrap;align-items:center}
.order ul{margin:0;padding-left:18px}
.prev{width:96px}
.empty{text-align:center;padding:40px 12px;color:var(--muted);display:grid;gap:12px;justify-items:center}
.empty svg{width:64px;height:64px;color:var(--line)}
.toast{position:fixed;left:50%;bottom:calc(76px + env(safe-area-inset-bottom,0px));transform:translate(-50%,20px);background:var(--ink);color:var(--bg);padding:10px 16px;border-radius:999px;font-weight:600;opacity:0;pointer-events:none;transition:opacity .2s,transform .2s;z-index:40;max-width:calc(100% - 32px);text-align:center}
.toast.show{opacity:1;transform:translate(-50%,0)}
.tabsx{display:flex;border:1px solid var(--line);border-radius:6px;overflow:hidden;background:var(--surface)}
.tabsx button{flex:1;border:0;background:none;padding:10px;font-weight:700}
.tabsx button.on{background:var(--ink);color:var(--bg)}
.hint{font-size:13px;color:var(--muted)}
.tbl{overflow-x:auto}
.hbtn{flex:none;width:36px;height:36px;border-radius:50%;border:2px solid var(--accent);color:var(--accent);display:grid;place-items:center;font-family:var(--f-display);font-weight:800;font-size:20px;line-height:1}
.faq details{background:var(--surface);border:1px solid var(--line);border-radius:8px;padding:0 14px}
.faq details+details{margin-top:8px}
.faq summary{cursor:pointer;padding:13px 0;font-weight:600;list-style:none;display:flex;justify-content:space-between;gap:10px}
.faq summary::-webkit-details-marker{display:none}
.faq summary::after{content:"+";font-size:20px;line-height:1;color:var(--muted)}
.faq details[open] summary::after{content:"−"}
.faq p,.faq ol{margin:0 0 14px;color:var(--muted)}
.faq ol{padding-left:20px}
.faq li+li{margin-top:4px}
.tel{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.tel b{font-family:var(--f-display);font-size:26px;letter-spacing:.03em;user-select:all;font-variant-numeric:tabular-nums}
.msg{border:1px solid var(--line);background:var(--surface);border-radius:8px;padding:12px;display:grid;gap:8px}
.reply{background:var(--bg);padding:8px 10px;border-radius:4px}
.menu{display:grid;gap:8px}
.steps{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:6px}
.st{display:grid;gap:6px;font-size:12px;color:var(--muted);text-align:center;justify-items:center;width:100%}
.st i{display:block;width:100%;height:6px;border-radius:3px;background:var(--line)}
.st.on{color:var(--ink);font-weight:600}
.st.on i{background:var(--accent)}
@media (prefers-reduced-motion:reduce){.toast{transition:none}}
</style>

<style>body{margin:0}[hidden]{display:none!important}img{max-width:100%}:root{padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}</style>
