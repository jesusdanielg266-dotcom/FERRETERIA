    return norm(p.name+' '+p.brand+' '+catName(p.cat)+' '+p.desc).indexOf(q)>=0;
  });
  if(S.sort==='asc')list.sort(function(a,b){return a.price-b.price});
  if(S.sort==='desc')list.sort(function(a,b){return b.price-a.price});
